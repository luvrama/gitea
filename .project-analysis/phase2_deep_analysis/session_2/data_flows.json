      "error_paths": [
        {"condition": "No token provided", "handler": "reqToken middleware", "response_code": 401, "response": "APIError"},
        {"condition": "Invalid JSON binding", "handler": "bind middleware", "response_code": 422, "response": "APIError with field error"},
        {"condition": "Unsupported render mode", "handler": "common.RenderMarkup default case", "response_code": 422, "response": "HTTP error: unsupported render mode"},
        {"condition": "util.ErrInvalidArgument from markup.Render", "handler": "common.RenderMarkup", "response_code": 422, "response": "HTTP error with err message"},
