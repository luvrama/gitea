          "output": "HTML written to response writer",
          "operations": [
            "Parse urlPathContext to extract owner/repo/ref/treePath",
            "Switch on mode: empty/markdown → NewRenderContextSimpleDocument + markdown.RenderRaw",
            "gfm/file → NewRenderContextRepoFile + markup.Render",
            "comment → NewRenderContextRepoComment + markup.Render",
            "wiki → NewRenderContextRepoWiki + markup.Render",
            "Set UseAbsoluteLink(true)"
          ],
          "calls_external": false,
          "database_ops": [],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 4,
