          "file_path": "modules/markup/markdown/markdown.go",
          "input": "RenderContext + text reader",
          "output": "Sanitized HTML to output writer",
          "operations": ["Parse markdown via goldmark", "Sanitize HTML output via bluemonday policy", "Pipe-based streaming: render → sanitize → output"],
          "calls_external": false,
          "database_ops": [],
          "cache_ops": [],
          "async": true
        }
      ],
      "data_transformations": [
