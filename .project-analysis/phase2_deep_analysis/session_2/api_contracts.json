        "errors": [
          {"status_code": 401, "type": "APIError", "condition": "No valid token provided (reqToken middleware)"},
          {"status_code": 422, "type": "validationError", "condition": "Invalid form binding or unsupported render mode"},
          {"status_code": 500, "type": "APIError", "condition": "Internal rendering error"}
