    {
      "endpoint_id": "ep-019",
      "http_method": "GET",
      "path": "/api/v1/notifications",
      "description": "Lists user notifications with pagination, filtering by status/subject/time, loading all related attributes",
      "steps": [
        {
          "step": 1,
          "component": "notify.getFindNotificationOptions",
          "type": "utility",
          "file_path": "routers/api/v1/notify/notifications.go",
          "input": "APIContext (query params)",
          "output": "FindNotificationOptions",
          "operations": ["Parse before/since timestamps via GetQueryBeforeSince", "Parse page/limit via GetListOptions", "Parse status-types with default [unread, pinned]", "Parse subject-type filter"],
          "calls_external": false,
          "database_ops": [],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 2,
          "component": "db.Count[Notification]",
          "type": "repository",
          "file_path": "models/db/list.go",
          "input": "FindNotificationOptions",
          "output": "int64 (total count)",
          "operations": ["Execute COUNT query on notification table with conditions"],
          "calls_external": false,
          "database_ops": [{"operation": "SELECT COUNT", "table": "notification", "description": "Count notifications matching filters"}],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 3,
          "component": "db.Find[Notification]",
          "type": "repository",
          "file_path": "models/db/list.go",
          "input": "FindNotificationOptions",
          "output": "[]*Notification",
          "operations": ["Execute paginated SELECT on notification table ordered by updated_unix DESC"],
          "calls_external": false,
          "database_ops": [{"operation": "SELECT", "table": "notification", "description": "Fetch paginated notifications matching filters"}],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 4,
          "component": "NotificationList.LoadAttributes",
          "type": "repository",
          "file_path": "models/activities/notification_list.go",
          "input": "[]*Notification",
          "output": "[]*Notification (with loaded relations)",
          "operations": ["Batch load repositories by IDs", "Batch load issues by IDs", "Batch load users by IDs", "Batch load comments by IDs"],
          "calls_external": false,
          "database_ops": [
            {"operation": "SELECT", "table": "repository", "description": "Batch load repos for notifications"},
            {"operation": "SELECT", "table": "issue", "description": "Batch load issues for notifications"},
            {"operation": "SELECT", "table": "user", "description": "Batch load users for notifications"},
            {"operation": "SELECT", "table": "comment", "description": "Batch load comments for notifications"}
          ],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 5,
          "component": "convert.ToNotifications",
          "type": "utility",
          "file_path": "services/convert/notification.go",
          "input": "[]*Notification",
          "output": "[]*api.NotificationThread",
          "operations": ["For each notification: check repo permission via GetIndividualUserRepoPermission", "Convert repo to API format", "Build subject based on source type", "For issue/PR subjects: call Issue.GetLastComment to get latest comment URL"],
          "calls_external": false,
          "database_ops": [
            {"operation": "SELECT", "table": "access/collaboration", "description": "GetIndividualUserRepoPermission per notification"},
            {"operation": "SELECT", "table": "comment", "description": "GetLastComment per issue notification"}
          ],
          "cache_ops": [],
          "async": false
        }
      ],
      "data_transformations": [
        {
          "from": "activities_model.Notification",
          "to": "api.NotificationThread",
          "component": "convert.ToNotificationThread",
          "mappings": [
            {"source_field": "ID", "target_field": "id", "transformation": "direct_copy"},
            {"source_field": "Repository", "target_field": "repository", "transformation": "computed (ToRepo with permission check)"},
            {"source_field": "Status", "target_field": "unread", "transformation": "computed (status != Read && status != Pinned)"},
            {"source_field": "Status", "target_field": "pinned", "transformation": "computed (status == Pinned)"},
            {"source_field": "UpdatedUnix", "target_field": "updated_at", "transformation": "computed (AsTime())"},
            {"source_field": "ID", "target_field": "url", "transformation": "computed (APIURL())"}
          ]
        }
      ],
      "error_paths": [
        {"condition": "Invalid before/since timestamp", "handler": "context.GetQueryBeforeSince", "response_code": 422, "response": "APIError"},
