          "mappings": [
            {"source_field": "ID", "target_field": "id", "transformation": "direct_copy"},
            {"source_field": "Status (updated)", "target_field": "unread", "transformation": "computed"},
            {"source_field": "Status (updated)", "target_field": "pinned", "transformation": "computed"},
            {"source_field": "UpdatedUnix", "target_field": "updated_at", "transformation": "computed"},
