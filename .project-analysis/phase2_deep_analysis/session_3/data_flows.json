        {"condition": "Database error on find", "handler": "notify.ListNotifications", "response_code": 500, "response": "APIErrorInternal"},
        {"condition": "LoadAttributes fails", "handler": "notify.ListNotifications", "response_code": 500, "response": "APIErrorInternal"}
      ]
