    {
      "endpoint_id": "ep-019",
      "http_method": "GET",
      "path": "/api/v1/notifications",
      "controller_class": "notify",
      "controller_method": "ListNotifications",
      "description": "List current user's notification threads with filtering by status, subject type, and time range",
      "request": {
        "path_params": [],
        "query_params": [
          {"name": "all", "type": "boolean", "required": false, "default": false, "validation": ["If true, show notifications marked as read"]},
          {"name": "status-types", "type": "[]string", "required": false, "default": "[\"unread\", \"pinned\"]", "validation": ["Options: unread, read, pinned"]},
          {"name": "subject-type", "type": "[]string", "required": false, "default": null, "validation": ["Options: issue, pull, commit, repository"]},
          {"name": "since", "type": "string (RFC3339)", "required": false, "default": null, "validation": ["Must be valid RFC3339 timestamp"]},
          {"name": "before", "type": "string (RFC3339)", "required": false, "default": null, "validation": ["Must be valid RFC3339 timestamp"]},
          {"name": "page", "type": "integer", "required": false, "default": 1, "validation": ["minimum 1"]},
          {"name": "limit", "type": "integer", "required": false, "default": 30, "validation": ["clamped to 1-50 by API settings"]}
        ],
        "headers": [
          {"name": "Authorization", "required": true, "description": "Token with notification scope"}
        ],
        "body": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "type": "[]NotificationThread",
          "fields": [
            {"name": "id", "type": "int64", "description": "Notification thread ID"},
            {"name": "repository", "type": "Repository", "description": "Associated repository (null if access revoked)"},
            {"name": "subject", "type": "NotificationSubject", "description": "Notification subject details"},
            {"name": "unread", "type": "bool", "description": "Whether notification is unread"},
            {"name": "pinned", "type": "bool", "description": "Whether notification is pinned"},
            {"name": "updated_at", "type": "time.Time", "description": "Last update timestamp"},
            {"name": "url", "type": "string", "description": "API URL for this thread"}
          ]
        },
        "errors": [
          {"status_code": 401, "type": "APIError", "condition": "No valid token provided"},
          {"status_code": 403, "type": "APIError", "condition": "Token lacks notification scope"},
          {"status_code": 422, "type": "APIError", "condition": "Invalid before/since timestamp format"}
        ]
      },
      "authentication": "bearer (notification scope)",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
