      "rule_id": "br-001",
      "category": "validation",
      "description": "Variable name must match pattern ^[A-Z_][A-Z0-9_]*$ (case insensitive)",
      "location": {"class": "secrets", "method": "ValidateName", "file_path": "services/secrets/validation.go", "line_number": 24},
      "condition": "!namePattern.MatchString(name)",
      "action": "Return ErrInvalidArgument",
      "affected_endpoints": ["ep-269", "ep-270"],
      "code_snippet": "if !vars.namePattern.MatchString(name) || vars.forbiddenPrefixPattern.MatchString(name)"
    },
    {
      "rule_id": "br-002",
      "category": "validation",
      "description": "Variable name must not start with GITEA_ or GITHUB_ prefix",
      "location": {"class": "secrets", "method": "ValidateName", "file_path": "services/secrets/validation.go", "line_number": 24},
      "condition": "forbiddenPrefixPattern.MatchString(name)",
      "action": "Return ErrInvalidArgument",
      "affected_endpoints": ["ep-269", "ep-270"],
      "code_snippet": "ret.forbiddenPrefixPattern = regexp.MustCompile(\"(?i)^GIT(EA|HUB)_\")"
    },
    {
      "rule_id": "br-003",
      "category": "validation",
