      "path": "/api/v1/repos/{owner}/{repo}/releases",
      "controller_class": "repo",
      "controller_method": "ListReleases",
      "description": "List a repository's releases with pagination and optional draft/pre-release filters",
      "request": {
        "path_params": [
          {"name": "owner", "type": "string", "required": true, "validation": []},
          {"name": "repo", "type": "string", "required": true, "validation": []}
        ],
        "query_params": [
          {"name": "draft", "type": "boolean", "required": false, "default": null, "validation": ["filter drafts; requires write access to see drafts"]},
          {"name": "pre-release", "type": "boolean", "required": false, "default": null, "validation": ["filter pre-releases"]},
          {"name": "page", "type": "integer", "required": false, "default": 1, "validation": ["minimum 1"]},
          {"name": "limit", "type": "integer", "required": false, "default": "setting.API.DefaultPagingNum", "validation": ["max setting.API.MaxResponseItems"]}
        ],
        "headers": [{"name": "Authorization", "required": false, "description": "Bearer token or basic auth"}],
        "body": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "type": "[]*api.Release",
          "fields": [
            {"name": "[]", "type": "api.Release", "description": "Array of release objects"}
          ]
        },
        "errors": [
          {"status_code": 404, "type": "notFound", "condition": "Repository not found"},
          {"status_code": 500, "type": "internal", "condition": "Database error"}
        ]
      },
      "authentication": "optional (required for draft access)",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
    {
      "endpoint_id": "ep-243",
      "http_method": "POST",
      "path": "/api/v1/repos/{owner}/{repo}/releases",
      "controller_class": "repo",
      "controller_method": "CreateRelease",
      "description": "Create a new release or convert an existing tag to a release",
      "request": {
        "path_params": [
          {"name": "owner", "type": "string", "required": true, "validation": []},
          {"name": "repo", "type": "string", "required": true, "validation": []}
        ],
        "query_params": [],
        "headers": [{"name": "Authorization", "required": true, "description": "Bearer token or basic auth"}],
        "body": {
          "type": "api.CreateReleaseOption",
          "content_type": "application/json",
          "fields": [
            {"name": "tag_name", "type": "string", "required": true, "validation": ["binding:Required"], "description": "Git tag name"},
            {"name": "tag_message", "type": "string", "required": false, "validation": [], "description": "Message for annotated tag"},
            {"name": "target_commitish", "type": "string", "required": false, "validation": [], "description": "Target branch/commit; defaults to default branch"},
            {"name": "name", "type": "string", "required": false, "validation": ["truncated to 255 chars"], "description": "Release title"},
            {"name": "body", "type": "string", "required": false, "validation": [], "description": "Release notes"},
            {"name": "draft", "type": "bool", "required": false, "validation": [], "description": "Mark as draft"},
            {"name": "prerelease", "type": "bool", "required": false, "validation": [], "description": "Mark as prerelease"}
          ]
        }
      },
      "response": {
        "success": {
          "status_code": 201,
          "type": "api.Release",
          "fields": [
            {"name": "id", "type": "int64", "description": "Release ID"},
            {"name": "tag_name", "type": "string", "description": "Git tag name"}
          ]
        },
        "errors": [
          {"status_code": 404, "type": "notFound", "condition": "Target commit/branch not found"},
          {"status_code": 409, "type": "error", "condition": "Release already exists for tag or tag already has a release"},
          {"status_code": 422, "type": "validationError", "condition": "Repo is empty or tag name is protected"}
        ]
      },
      "authentication": "bearer (write:repository scope)",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
