      "controller_method": "EditRelease",
      "description": "Update a release's metadata (tag name, target, title, note, draft/prerelease status)",
      "request": {
        "path_params": [
          {"name": "owner", "type": "string", "required": true, "validation": []},
          {"name": "repo", "type": "string", "required": true, "validation": []},
