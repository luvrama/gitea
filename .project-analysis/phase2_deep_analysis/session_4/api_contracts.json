            {"name": "repository", "type": "Repository", "description": "associated repository"},
            {"name": "subject", "type": "NotificationSubject", "description": "notification subject details"},
            {"name": "unread", "type": "bool", "description": "whether notification is unread"},
            {"name": "pinned", "type": "bool", "description": "whether notification is pinned"},
            {"name": "updated_at", "type": "time.Time", "description": "last update time"},
            {"name": "url", "type": "string", "description": "API URL for this thread"}
