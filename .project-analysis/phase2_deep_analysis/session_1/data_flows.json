      "description": "Loads a label template file by display name and returns parsed labels",
      "steps": [
        {
          "step": 1,
          "component": "misc.GetLabelTemplate",
          "type": "controller",
          "file_path": "routers/api/v1/misc/label_templates.go",
          "input": "APIContext with path param 'name'",
          "output": "JSON([]*api.LabelTemplate) or 404",
          "operations": ["Sanitize name via util.PathJoinRelX", "Call repo_module.LoadTemplateLabelsByDisplayName"],
          "calls_external": false,
          "database_ops": [],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 2,
          "component": "repo_module.LoadTemplateLabelsByDisplayName",
          "type": "utility",
          "file_path": "modules/repository/init.go",
          "input": "displayName string",
          "output": "[]*label.Label or error",
          "operations": ["Lookup displayName in labelTemplateFileMap", "Call label.LoadTemplateFile if found"],
          "calls_external": false,
          "database_ops": [],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 3,
          "component": "convert.ToLabelTemplateList",
          "type": "utility",
          "file_path": "services/convert/issue.go",
          "input": "[]*label.Label",
          "output": "[]*api.LabelTemplate",
          "operations": ["Map each label to API struct, strip # from color"],
          "calls_external": false,
          "database_ops": [],
          "cache_ops": [],
          "async": false
        }
      ],
      "data_transformations": [
        {
          "from": "*label.Label",
          "to": "*api.LabelTemplate",
          "component": "convert.ToLabelTemplate",
          "mappings": [
            {"source_field": "Name", "target_field": "name", "transformation": "direct_copy"},
            {"source_field": "Exclusive", "target_field": "exclusive", "transformation": "direct_copy"},
            {"source_field": "Color", "target_field": "color", "transformation": "computed"},
            {"source_field": "Description", "target_field": "description", "transformation": "direct_copy"}
          ]
        }
      ],
      "error_paths": [
        {"condition": "Template name not found in labelTemplateFileMap", "handler": "ctx.APIErrorNotFound", "response_code": 404, "response": "notFound"}
      ]
    },
    {
      "endpoint_id": "ep-004",
      "http_method": "GET",
      "path": "/api/v1/signing-key.gpg",
      "description": "Returns the global GPG signing key by calling git config and gpg --export",
      "steps": [
        {
          "step": 1,
          "component": "misc.SigningKeyGPG",
          "type": "controller",
          "file_path": "routers/api/v1/misc/signing.go",
          "input": "APIContext",
          "output": "text/plain GPG key or error",
          "operations": ["Call getSigningKey with format=openpgp"],
          "calls_external": false,
          "database_ops": [],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 2,
          "component": "asymkey_service.PublicSigningKey",
          "type": "service",
          "file_path": "services/asymkey/sign.go",
          "input": "context.Context",
          "output": "content string, format string, error",
          "operations": ["Call git.GetSigningKey to get key info", "If SSH format: read file from disk", "If GPG format: exec gpg --export -a <keyID>"],
          "calls_external": true,
          "database_ops": [],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 3,
          "component": "git.GetSigningKey",
          "type": "utility",
          "file_path": "modules/git/key.go",
          "input": "context.Context",
          "output": "*SigningKey, *Signature",
          "operations": ["Check setting.Repository.Signing.SigningKey", "If 'none': return nil", "If 'default': read git global config", "Otherwise: use configured key"],
          "calls_external": true,
          "database_ops": [],
          "cache_ops": [],
          "async": false
        }
      ],
      "data_transformations": [],
      "error_paths": [
        {"condition": "No signing key configured (format empty)", "handler": "ctx.APIErrorNotFound", "response_code": 404, "response": "no signing key"},
        {"condition": "Key format doesn't match expected (openpgp)", "handler": "ctx.APIErrorNotFound", "response_code": 404, "response": "signing key format is <format>"},
        {"condition": "Error reading key or running gpg", "handler": "ctx.APIErrorInternal", "response_code": 500, "response": "APIError"}
      ]
    },
