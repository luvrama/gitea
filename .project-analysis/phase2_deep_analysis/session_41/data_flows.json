          "file_path": "modules/actions/workflows.go",
          "input": "git.Commit",
          "output": "folder string, git.Entries",
          "operations": ["traverse commit tree for workflow dirs (.gitea/workflows, .github/workflows)", "filter entries by .yml/.yaml extension"],
          "calls_external": false,
          "database_ops": [],
          "cache_ops": [],
          "async": false
        }
      ],
      "data_transformations": [
        {
          "from": "git.TreeEntry",
          "to": "api.ActionWorkflow",
          "component": "convert.getActionWorkflowEntry",
          "mappings": [
            {"source_field": "entry.Name()", "target_field": "ID", "transformation": "direct_copy"},
            {"source_field": "workflow.Name or entry.Name()", "target_field": "Name", "transformation": "computed"},
            {"source_field": "folder + entry.Name()", "target_field": "Path", "transformation": "computed"},
            {"source_field": "cfg.IsWorkflowDisabled()", "target_field": "State", "transformation": "computed"}
          ]
        }
      ],
      "error_paths": [
