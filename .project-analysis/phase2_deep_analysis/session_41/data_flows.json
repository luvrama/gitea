          "component": "convert.ListActionWorkflows",
          "type": "utility",
          "file_path": "services/convert/convert.go",
          "input": "gitRepo, repo",
          "output": "[]*api.ActionWorkflow",
          "operations": ["get default branch commit from git", "call actions.ListWorkflows to find .yml/.yaml files", "for each entry call getActionWorkflowEntry"],
          "calls_external": false,
          "database_ops": [
