  "rules": [
    {
      "rule_id": "br-001",
      "category": "validation",
      "description": "Avatar image must be valid base64 encoded",
      "location": {"class": "repo", "method": "UpdateAvatar", "file_path": "routers/api/v1/repo/avatar.go", "line_number": 42},
      "condition": "base64.StdEncoding.DecodeString fails",
      "action": "Return 400 Bad Request",
      "affected_endpoints": ["ep-262"],
      "code_snippet": "content, err := base64.StdEncoding.DecodeString(form.Image)"
    },
    {
      "rule_id": "br-002",
      "category": "validation",
      "description": "Avatar image must be png, jpeg, gif, or webp format",
      "location": {"class": "avatar", "method": "processAvatarImage", "file_path": "modules/avatar/avatar.go", "line_number": 57},
      "condition": "imgType not in [png, jpeg, gif, webp]",
      "action": "Return error 'unsupported avatar image type'",
      "affected_endpoints": ["ep-262"],
      "code_snippet": "if imgType != \"png\" && imgType != \"jpeg\" && imgType != \"gif\" && imgType != \"webp\" {"
    },
    {
      "rule_id": "br-003",
      "category": "validation",
      "description": "Avatar image dimensions must not exceed configured max width/height",
      "location": {"class": "avatar", "method": "processAvatarImage", "file_path": "modules/avatar/avatar.go", "line_number": 62},
      "condition": "imgCfg.Width > setting.Avatar.MaxWidth or imgCfg.Height > setting.Avatar.MaxHeight",
      "action": "Return error with dimension details",
      "affected_endpoints": ["ep-262"],
      "code_snippet": "if imgCfg.Width > setting.Avatar.MaxWidth {"
    },
    {
      "rule_id": "br-004",
      "category": "business_logic",
      "description": "Skip avatar upload if same image hash already set",
      "location": {"class": "repository", "method": "UploadAvatar", "file_path": "services/repository/avatar.go", "line_number": 28},
      "condition": "repo.Avatar == newAvatar (same hash)",
      "action": "Return nil (no-op)",
      "affected_endpoints": ["ep-262"],
      "code_snippet": "if repo.Avatar == newAvatar { return nil }"
    },
    {
      "rule_id": "br-005",
      "category": "business_logic",
      "description": "Skip avatar deletion if no avatar exists",
      "location": {"class": "repository", "method": "DeleteAvatar", "file_path": "services/repository/avatar.go", "line_number": 60},
      "condition": "len(repo.Avatar) == 0",
      "action": "Return nil (no-op)",
      "affected_endpoints": ["ep-263"],
      "code_snippet": "if len(repo.Avatar) == 0 { return nil }"
    },
    {
      "rule_id": "br-006",
      "category": "validation",
