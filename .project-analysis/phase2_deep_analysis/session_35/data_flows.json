      "description": "Validates repo is a pull mirror and adds it to the mirror sync queue",
      "steps": [
        {
          "step": 1,
          "component": "repo.MirrorSync",
          "type": "controller",
          "file_path": "routers/api/v1/repo/mirror.go",
          "input": "APIContext with repo loaded",
          "output": "HTTP 200 or error",
          "operations": ["Check write permission on code unit", "Check mirror feature enabled", "Verify repo is a pull mirror"],
          "calls_external": false,
          "database_ops": [{"operation": "SELECT", "table": "mirror", "description": "GetMirrorByRepoID to verify repo is a pull mirror"}],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 2,
          "component": "mirror_service.AddPullMirrorToQueue",
          "type": "service",
          "file_path": "services/mirror/queue.go",
          "input": "repoID int64",
          "output": "void (async push to queue)",
          "operations": ["Push SyncRequest{PullMirrorType, repoID} to mirror queue in goroutine"],
          "calls_external": false,
          "database_ops": [],
          "cache_ops": [],
          "async": true
        }
      ],
      "data_transformations": [],
      "error_paths": [
        {"condition": "User lacks write access to code unit", "handler": "middleware reqRepoWriter", "response_code": 403, "response": "forbidden"},
        {"condition": "Mirror.Enabled is false", "handler": "repo.MirrorSync", "response_code": 400, "response": "Mirror feature is disabled"},
        {"condition": "No mirror record for repo", "handler": "repo.MirrorSync", "response_code": 400, "response": "Repository is not a mirror"},
        {"condition": "DB error on GetMirrorByRepoID", "handler": "repo.MirrorSync", "response_code": 500, "response": "internal error"}
      ]
    },
