    {
      "endpoint_id": "ep-299",
      "http_method": "GET",
      "path": "/api/v1/repos/{owner}/{repo}/git/notes/{sha}",
      "controller_class": "repo",
      "controller_method": "GetNote",
      "description": "Get a note corresponding to a single commit from a repository",
      "request": {
        "path_params": [
          {"name": "owner", "type": "string", "required": true, "validation": []},
          {"name": "repo", "type": "string", "required": true, "validation": []},
          {"name": "sha", "type": "string", "required": true, "validation": ["must pass git.IsValidRefPattern"]}
        ],
        "query_params": [
          {"name": "verification", "type": "boolean", "required": false, "default": "true", "validation": []},
          {"name": "files", "type": "boolean", "required": false, "default": "true", "validation": []}
        ],
        "headers": [],
        "body": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "type": "api.Note",
          "fields": [
            {"name": "message", "type": "string", "description": "The content message of the git note"},
            {"name": "commit", "type": "api.Commit", "description": "The commit that this note is attached to"}
          ]
        },
        "errors": [
          {"status_code": 422, "type": "validationError", "condition": "sha is not a valid git ref pattern"},
          {"status_code": 404, "type": "notFound", "condition": "commit or note does not exist"}
        ]
      },
      "authentication": "token",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
