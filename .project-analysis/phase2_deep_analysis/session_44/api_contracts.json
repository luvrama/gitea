      "response": {
        "success": {
          "status_code": 200,
          "type": "[]api.Reaction",
          "fields": [
            {"name": "user", "type": "api.User", "description": "The user who created the reaction"},
            {"name": "content", "type": "string", "description": "The reaction type/emoji"},
            {"name": "created_at", "type": "time.Time", "description": "When the reaction was created"}
          ]
        },
        "errors": [
