        ],
        "query_params": [],
        "headers": [],
        "body": null
      },
      "response": {
        "success": {"status_code": 204, "type": "empty", "fields": []},
        "errors": [
          {"status_code": 404, "type": "notFound", "condition": "PR not found or not merged"}
        ]
      },
      "authentication": "bearer",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
    {
      "endpoint_id": "ep-229",
      "http_method": "POST",
      "path": "/api/v1/repos/{owner}/{repo}/pulls/{index}/merge",
      "controller_class": "repo",
      "controller_method": "MergePullRequest",
      "description": "Merge a pull request or schedule auto-merge",
      "request": {
        "path_params": [
          {"name": "owner", "type": "string", "required": true, "validation": []},
          {"name": "repo", "type": "string", "required": true, "validation": []},
          {"name": "index", "type": "int64", "required": true, "validation": []}
        ],
        "query_params": [],
        "headers": [{"name": "Authorization", "required": true, "description": "Bearer token or basic auth"}],
        "body": {
          "type": "MergePullRequestOption",
          "content_type": "application/json",
          "fields": [
            {"name": "do", "type": "string", "required": true, "validation": ["Required", "In(merge,rebase,rebase-merge,squash,fast-forward-only,manually-merged)"], "description": "Merge style"},
            {"name": "merge_title_field", "type": "string", "required": false, "validation": [], "description": "Custom merge commit title"},
            {"name": "merge_message_field", "type": "string", "required": false, "validation": [], "description": "Custom merge commit message body"},
            {"name": "merge_commit_id", "type": "string", "required": false, "validation": [], "description": "Commit ID for manually-merged"},
            {"name": "head_commit_id", "type": "string", "required": false, "validation": [], "description": "Expected head commit ID"},
            {"name": "force_merge", "type": "bool", "required": false, "validation": [], "description": "Force merge even if checks fail (admin)"},
            {"name": "merge_when_checks_succeed", "type": "bool", "required": false, "validation": [], "description": "Schedule auto-merge"},
            {"name": "delete_branch_after_merge", "type": "*bool", "required": false, "validation": [], "description": "Delete head branch after merge"}
          ]
        }
      },
      "response": {
        "success": {"status_code": 200, "type": "empty", "fields": []},
        "errors": [
          {"status_code": 403, "type": "forbidden", "condition": "No permission to merge"},
          {"status_code": 404, "type": "notFound", "condition": "PR not found or closed"},
          {"status_code": 405, "type": "empty", "condition": "Not allowed (WIP, not mergeable, wrong style, signing required)"},
          {"status_code": 409, "type": "error", "condition": "Merge conflict, push out of date, head out of date, already scheduled"},
          {"status_code": 423, "type": "repoArchivedError", "condition": "Repository is archived"}
        ]
      },
      "authentication": "bearer",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
    {
