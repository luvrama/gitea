    {
      "endpoint_id": "ep-226",
      "http_method": "POST",
      "path": "/api/v1/repos/{owner}/{repo}/pulls",
      "controller_class": "repo",
      "controller_method": "CreatePullRequest",
      "description": "Create a new pull request",
      "request": {
        "path_params": [
          {"name": "owner", "type": "string", "required": true, "validation": []},
          {"name": "repo", "type": "string", "required": true, "validation": []}
        ],
        "query_params": [],
        "headers": [{"name": "Authorization", "required": true, "description": "Bearer token or basic auth"}],
        "body": {
          "type": "CreatePullRequestOption",
          "content_type": "application/json",
          "fields": [
            {"name": "head", "type": "string", "required": true, "validation": ["Required"], "description": "Head branch or username:branch"},
            {"name": "base", "type": "string", "required": true, "validation": ["Required"], "description": "Base branch"},
            {"name": "title", "type": "string", "required": true, "validation": ["Required"], "description": "PR title"},
            {"name": "body", "type": "string", "required": false, "validation": [], "description": "PR description"},
            {"name": "assignee", "type": "string", "required": false, "validation": [], "description": "Primary assignee username"},
            {"name": "assignees", "type": "[]string", "required": false, "validation": [], "description": "List of assignee usernames"},
            {"name": "milestone", "type": "int64", "required": false, "validation": [], "description": "Milestone ID"},
            {"name": "labels", "type": "[]int64", "required": false, "validation": [], "description": "Label IDs"},
            {"name": "due_date", "type": "time.Time", "required": false, "validation": [], "description": "Deadline"},
            {"name": "reviewers", "type": "[]string", "required": false, "validation": [], "description": "Reviewer usernames"},
            {"name": "team_reviewers", "type": "[]string", "required": false, "validation": [], "description": "Team reviewer names"},
            {"name": "allow_maintainer_edit", "type": "*bool", "required": false, "validation": [], "description": "Allow maintainer edits"}
          ]
        }
      },
      "response": {
        "success": {"status_code": 201, "type": "PullRequest", "fields": []},
        "errors": [
          {"status_code": 403, "type": "forbidden", "condition": "User blocked or must be collaborator"},
          {"status_code": 404, "type": "notFound", "condition": "Repo or branch not found"},
          {"status_code": 409, "type": "error", "condition": "PR already exists for same head/base"},
          {"status_code": 422, "type": "validationError", "condition": "Head equals base, invalid assignee, or refs not branches"},
          {"status_code": 423, "type": "repoArchivedError", "condition": "Repository is archived"}
        ]
      },
      "authentication": "bearer",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
    {
      "endpoint_id": "ep-227",
      "http_method": "PATCH",
      "path": "/api/v1/repos/{owner}/{repo}/pulls/{index}",
      "controller_class": "repo",
      "controller_method": "EditPullRequest",
      "description": "Update a pull request (title, body, assignees, labels, milestone, state, base branch, deadline, allow_maintainer_edit)",
      "request": {
        "path_params": [
          {"name": "owner", "type": "string", "required": true, "validation": []},
          {"name": "repo", "type": "string", "required": true, "validation": []},
          {"name": "index", "type": "int64", "required": true, "validation": []}
        ],
        "query_params": [],
        "headers": [{"name": "Authorization", "required": true, "description": "Bearer token or basic auth"}],
        "body": {
          "type": "EditPullRequestOption",
          "content_type": "application/json",
          "fields": [
            {"name": "title", "type": "string", "required": false, "validation": [], "description": "New title"},
            {"name": "body", "type": "*string", "required": false, "validation": [], "description": "New body"},
            {"name": "base", "type": "string", "required": false, "validation": [], "description": "New base branch"},
            {"name": "assignee", "type": "string", "required": false, "validation": [], "description": "Primary assignee"},
            {"name": "assignees", "type": "[]string", "required": false, "validation": [], "description": "Assignee list"},
            {"name": "milestone", "type": "int64", "required": false, "validation": [], "description": "Milestone ID"},
            {"name": "labels", "type": "[]int64", "required": false, "validation": [], "description": "Label IDs"},
            {"name": "state", "type": "*string", "required": false, "validation": [], "description": "open or closed"},
            {"name": "due_date", "type": "*time.Time", "required": false, "validation": [], "description": "Deadline"},
            {"name": "unset_due_date", "type": "*bool", "required": false, "validation": [], "description": "Remove deadline"},
            {"name": "allow_maintainer_edit", "type": "*bool", "required": false, "validation": [], "description": "Allow maintainer edits"},
            {"name": "content_version", "type": "*int", "required": false, "validation": [], "description": "Optimistic concurrency version"}
          ]
        }
      },
      "response": {
        "success": {"status_code": 201, "type": "PullRequest", "fields": []},
        "errors": [
          {"status_code": 403, "type": "forbidden", "condition": "Not poster and no write permission, or blocked user"},
          {"status_code": 404, "type": "notFound", "condition": "PR or new base branch not found"},
          {"status_code": 409, "type": "error", "condition": "Content version conflict or PR already exists for new base"},
          {"status_code": 412, "type": "error", "condition": "PR already merged, cannot change state"},
          {"status_code": 422, "type": "validationError", "condition": "Invalid assignee or issue is closed"}
        ]
      },
      "authentication": "bearer",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
