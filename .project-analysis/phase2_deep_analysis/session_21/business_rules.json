    },
    {
      "rule_id": "br-003",
      "category": "authorization",
      "description": "Blocked users cannot follow each other (bidirectional check)",
      "location": {"class": "user_model", "method": "FollowUser", "file_path": "models/user/follow.go", "line_number": 37},
      "condition": "IsUserBlockedBy(ctx, user, follow.ID) || IsUserBlockedBy(ctx, follow, user.ID)",
      "action": "return ErrBlockedUser",
      "affected_endpoints": ["ep-145"],
      "code_snippet": "if IsUserBlockedBy(ctx, user, follow.ID) || IsUserBlockedBy(ctx, follow, user.ID) {\n\treturn ErrBlockedUser\n}"
    },
    {
      "rule_id": "br-004",
      "category": "business_logic",
      "description": "Self-unfollow is a no-op",
      "location": {"class": "user_model", "method": "UnfollowUser", "file_path": "models/user/follow.go", "line_number": 56},
      "condition": "userID == followID",
      "action": "return nil (no-op)",
      "affected_endpoints": ["ep-146"],
      "code_snippet": "if userID == followID || !IsFollowing(ctx, userID, followID) {\n\treturn nil\n}"
    },
    {
      "rule_id": "br-005",
      "category": "business_logic",
      "description": "Unfollow when not following is a no-op",
      "location": {"class": "user_model", "method": "UnfollowUser", "file_path": "models/user/follow.go", "line_number": 56},
      "condition": "!IsFollowing(ctx, userID, followID)",
      "action": "return nil (no-op, idempotent)",
      "affected_endpoints": ["ep-146"],
      "code_snippet": "if userID == followID || !IsFollowing(ctx, userID, followID) {\n\treturn nil\n}"
    },
