      "rule_id": "br-001",
      "category": "business_logic",
      "description": "Self-follow is a no-op (returns nil without error)",
      "location": {"class": "user_model", "method": "FollowUser", "file_path": "models/user/follow.go", "line_number": 33},
      "condition": "user.ID == follow.ID",
      "action": "return nil (no-op)",
      "affected_endpoints": ["ep-145"],
      "code_snippet": "if user.ID == follow.ID || IsFollowing(ctx, user.ID, follow.ID) {\n\treturn nil\n}"
    },
    {
      "rule_id": "br-002",
      "category": "business_logic",
      "description": "Already-following is a no-op (returns nil without error)",
      "location": {"class": "user_model", "method": "FollowUser", "file_path": "models/user/follow.go", "line_number": 33},
      "condition": "IsFollowing(ctx, user.ID, follow.ID) == true",
      "action": "return nil (no-op, idempotent)",
