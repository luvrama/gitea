    {
      "rule_id": "br-001",
      "category": "validation",
      "description": "URL in webhook config must be a valid URL",
      "location": {"class": "utils", "method": "editHook", "file_path": "routers/api/v1/utils/hook.go", "line_number": 248},
      "condition": "url provided in form.Config and !validation.IsValidURL(url)",
      "action": "Return 422 'Invalid url'",
      "affected_endpoints": ["ep-150"],
      "code_snippet": "if !validation.IsValidURL(url) {\n\tctx.APIError(http.StatusUnprocessableEntity, \"Invalid url\")\n\treturn false\n}"
    },
    {
      "rule_id": "br-002",
      "category": "validation",
      "description": "Content type in webhook config must be 'json' or 'form'",
