    },
    {
      "rule_id": "br-003",
      "category": "authorization",
      "description": "Webhooks must be enabled by administrator",
      "location": {"class": "api", "method": "reqWebhooksEnabled", "file_path": "routers/api/v1/api.go", "line_number": 567},
      "condition": "setting.DisableWebhooks is true",
      "action": "Return 403 'webhooks disabled by administrator'",
      "affected_endpoints": ["ep-150", "ep-151"],
      "code_snippet": "if setting.DisableWebhooks {\n\tctx.APIError(http.StatusForbidden, \"webhooks disabled by administrator\")\n}"
    },
    {
      "rule_id": "br-004",
