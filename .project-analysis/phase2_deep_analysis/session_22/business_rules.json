      "condition": "star=true and not already starring",
      "action": "Insert star, increment repo num_stars, increment user num_stars in transaction",
      "affected_endpoints": ["ep-155"],
      "code_snippet": "return db.WithTx(ctx, func(ctx context.Context) error {"
    },
