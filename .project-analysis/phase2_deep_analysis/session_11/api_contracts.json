    {
      "endpoint_id": "ep-070",
      "http_method": "GET",
      "path": "/api/v1/orgs/{org}/members",
      "controller_class": "org",
      "controller_method": "ListMembers",
      "description": "List an organization's members. If the doer is a member or admin, shows all members; otherwise shows only public members.",
      "request": {
        "path_params": [{"name": "org", "type": "string", "required": true, "validation": ["resolved by orgAssignment middleware via GetOrgByName"]}],
        "query_params": [
          {"name": "page", "type": "integer", "required": false, "default": 1, "validation": ["min 1"]},
          {"name": "limit", "type": "integer", "required": false, "default": "setting.API.DefaultPagingNum", "validation": ["clamped to 1..setting.API.MaxResponseItems"]}
        ],
        "headers": [{"name": "Authorization", "required": true, "description": "Token authentication (reqToken middleware)"}],
        "body": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "type": "[]*api.User",
          "fields": [
            {"name": "id", "type": "int64", "description": "user ID"},
            {"name": "login", "type": "string", "description": "username"},
            {"name": "full_name", "type": "string", "description": "full name"},
            {"name": "email", "type": "string", "description": "email (may be placeholder if private)"},
            {"name": "avatar_url", "type": "string", "description": "avatar URL"},
            {"name": "html_url", "type": "string", "description": "profile URL"},
            {"name": "created", "type": "time", "description": "creation time"},
            {"name": "restricted", "type": "bool", "description": "is restricted user"},
            {"name": "visibility", "type": "string", "description": "user visibility"},
            {"name": "followers_count", "type": "int", "description": "follower count"},
            {"name": "following_count", "type": "int", "description": "following count"},
            {"name": "starred_repos_count", "type": "int", "description": "starred repos count"}
          ]
        },
        "errors": [
          {"status_code": 404, "type": "notFound", "condition": "Organization does not exist"}
        ]
      },
      "authentication": "bearer",
      "rate_limiting": null,
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
