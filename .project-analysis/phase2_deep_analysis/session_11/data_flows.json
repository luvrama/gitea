        {"condition": "DB error on IsOrgMember", "handler": "ListMembers", "response_code": 500, "response": "internal error"},
        {"condition": "DB error on CountOrgMembers/FindOrgMembers", "handler": "listMembers", "response_code": 500, "response": "internal error"}
      ]
