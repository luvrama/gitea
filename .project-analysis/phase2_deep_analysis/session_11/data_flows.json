          "from": "user_model.User",
          "to": "api.User",
          "component": "convert.ToUser",
          "mappings": [
            {"source_field": "ID", "target_field": "id", "transformation": "direct_copy"},
            {"source_field": "Name", "target_field": "login", "transformation": "direct_copy"},
            {"source_field": "FullName", "target_field": "full_name", "transformation": "direct_copy"},
            {"source_field": "Email", "target_field": "email", "transformation": "computed"},
            {"source_field": "AvatarLink()", "target_field": "avatar_url", "transformation": "computed"}
          ]
        }
      ],
      "error_paths": [
