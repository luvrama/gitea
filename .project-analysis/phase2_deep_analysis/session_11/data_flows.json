          "database_ops": [
            {"operation": "SELECT", "table": "org_user", "description": "COUNT with visibility filter"},
            {"operation": "SELECT", "table": "org_user", "description": "Get OrgUser records with pagination"},
            {"operation": "SELECT", "table": "user", "description": "GetUsersByIDs for member details"}
