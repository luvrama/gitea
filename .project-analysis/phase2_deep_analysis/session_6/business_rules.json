{
  "total_rules": 12,
  "rules": [
    {
      "rule_id": "br-001",
      "category": "authorization",
      "description": "Activity feeds include private actions only if user is admin or org member",
      "location": {"class": "org", "method": "ListOrgActivityFeeds", "file_path": "routers/api/v1/org/org.go", "line_number": 474},
      "condition": "ctx.IsSigned && (ctx.Doer.IsAdmin || org.IsOrgMember(ctx, ctx.Doer.ID))",
      "action": "set includePrivate = true",
      "affected_endpoints": ["ep-035"],
      "code_snippet": "includePrivate = isMember"
    },
    {
      "rule_id": "br-002",
      "category": "authorization",
      "description": "Org repo deletion requires org ownership (not just membership)",
      "location": {"class": "middleware", "method": "reqOrgOwnership", "file_path": "routers/api/v1/api.go", "line_number": 0},
      "condition": "user must have AccessModeOwner in team_user join",
      "action": "allow DELETE /orgs/{org}/repos",
      "affected_endpoints": ["ep-036"],
      "code_snippet": "reqToken(), reqOrgOwnership(), tokenRequiresScopes(...)"
    },
    {
      "rule_id": "br-003",
      "category": "business_logic",
      "description": "Org repo deletion is async - returns 202 immediately, deletes in background",
      "location": {"class": "org", "method": "DeleteOrgRepos", "file_path": "routers/api/v1/org/org.go", "line_number": 569},
      "condition": "len(repoIDs) > 0",
      "action": "spawn goroutine with graceful shutdown context",
      "affected_endpoints": ["ep-036"],
      "code_snippet": "go deleteOrgReposBackground(graceful.GetManager().ShutdownContext(), ctx.Org.Organization, repoIDs, ctx.Doer)"
    },
    {
      "rule_id": "br-004",
      "category": "business_logic",
      "description": "If org has no repos, return 204 No Content instead of 202",
      "location": {"class": "org", "method": "DeleteOrgRepos", "file_path": "routers/api/v1/org/org.go", "line_number": 565},
      "condition": "len(repoIDs) == 0",
      "action": "return 204 immediately",
      "affected_endpoints": ["ep-036"],
      "code_snippet": "if len(repoIDs) == 0 { ctx.Status(http.StatusNoContent); return }"
    },
    {
      "rule_id": "br-005",
      "category": "business_logic",
      "description": "Background repo deletion continues on individual failures, logs as system notice",
      "location": {"class": "org", "method": "deleteOrgReposBackground", "file_path": "routers/api/v1/org/org.go", "line_number": 523},
      "condition": "DeleteRepository returns error",
      "action": "create system notice, log error, continue to next repo",
      "affected_endpoints": ["ep-036"],
      "code_snippet": "_ = system_model.CreateNotice(ctx, system_model.NoticeRepository, desc)"
    },
    {
      "rule_id": "br-006",
      "category": "validation",
      "description": "Avatar image must be valid base64 and supported image type (png/jpeg/gif/webp)",
      "location": {"class": "avatar", "method": "processAvatarImage", "file_path": "modules/avatar/avatar.go", "line_number": 55},
      "condition": "imgType != png/jpeg/gif/webp",
      "action": "return error 'unsupported avatar image type'",
      "affected_endpoints": ["ep-037"],
      "code_snippet": "if imgType != \"png\" && imgType != \"jpeg\" && imgType != \"gif\" && imgType != \"webp\" {"
    },
    {
      "rule_id": "br-007",
      "category": "validation",
      "description": "Avatar image dimensions must not exceed configured max (default 4096x4096)",
      "location": {"class": "avatar", "method": "processAvatarImage", "file_path": "modules/avatar/avatar.go", "line_number": 60},
      "condition": "imgCfg.Width > setting.Avatar.MaxWidth || imgCfg.Height > setting.Avatar.MaxHeight",
      "action": "return error",
      "affected_endpoints": ["ep-037"],
      "code_snippet": "if imgCfg.Width > setting.Avatar.MaxWidth {"
    },
    {
      "rule_id": "br-008",
      "category": "business_logic",
      "description": "Small avatar images (< MaxOriginSize=256KB) are stored as-is without processing",
      "location": {"class": "avatar", "method": "processAvatarImage", "file_path": "modules/avatar/avatar.go", "line_number": 69},
      "condition": "len(data) < maxOriginSize",
      "action": "return original data unchanged",
      "affected_endpoints": ["ep-037"],
      "code_snippet": "if len(data) < int(maxOriginSize) { return data, nil }"
    },
    {
      "rule_id": "br-009",
      "category": "validation",
      "description": "Secret names must match ^[A-Z_][A-Z0-9_]*$ and not start with GITEA_/GITHUB_ or be 'CI'",
      "location": {"class": "secrets", "method": "ValidateName", "file_path": "services/secrets/validation.go", "line_number": 26},
      "condition": "!namePattern.MatchString(name) || forbiddenPrefixPattern.MatchString(name) || name=='CI'",
      "action": "return util.ErrInvalidArgument",
      "affected_endpoints": ["ep-040"],
      "code_snippet": "if !vars.namePattern.MatchString(name) || vars.forbiddenPrefixPattern.MatchString(name) || strings.EqualFold(name, \"CI\") {"
    },
    {
      "rule_id": "br-010",
      "category": "validation",
      "description": "Secret data max length is 65536 bytes",
      "location": {"class": "secret_model", "method": "InsertEncryptedSecret", "file_path": "models/secret/secret.go", "line_number": 76},
      "condition": "len(data) > SecretDataMaxLength",
      "action": "return util.ErrInvalidArgument 'data too long'",
      "affected_endpoints": ["ep-040"],
      "code_snippet": "if len(data) > SecretDataMaxLength { return nil, util.NewInvalidArgumentErrorf(\"data too long\") }"
    },
    {
      "rule_id": "br-011",
      "category": "business_logic",
      "description": "Secret names are stored uppercase (case-insensitive matching)",
      "location": {"class": "secret_model", "method": "InsertEncryptedSecret", "file_path": "models/secret/secret.go", "line_number": 86},
      "condition": "always",
      "action": "name = strings.ToUpper(name)",
      "affected_endpoints": ["ep-040", "ep-041"],
      "code_snippet": "Name: strings.ToUpper(name)"
    },
    {
      "rule_id": "br-012",
      "category": "business_logic",
      "description": "Secret description is truncated to 4096 runes",
      "location": {"class": "secret_model", "method": "InsertEncryptedSecret", "file_path": "models/secret/secret.go", "line_number": 78},
      "condition": "len(description) > SecretDescriptionMaxLength",
      "action": "truncate to 4096 runes",
      "affected_endpoints": ["ep-040"],
      "code_snippet": "description = util.TruncateRunes(description, SecretDescriptionMaxLength)"
    }
  ]
}
