      "http_method": "GET",
      "path": "/api/v1/orgs/{org}/activities/feeds",
      "controller_class": "org",
      "controller_method": "ListOrgActivityFeeds",
      "description": "List an organization's activity feeds",
      "request": {
        "path_params": [{"name": "org", "type": "string", "required": true, "validation": ["resolved by orgAssignment(true) middleware"]}],
        "query_params": [
          {"name": "date", "type": "string", "required": false, "default": null, "validation": ["format: date (YYYY-MM-DD)"]},
          {"name": "page", "type": "integer", "required": false, "default": 1, "validation": ["min 1"]},
          {"name": "limit", "type": "integer", "required": false, "default": null, "validation": ["corrected by ToCorrectPageSize"]}
        ],
        "headers": [],
        "body": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "type": "[]*api.Activity",
          "fields": [
            {"name": "id", "type": "int64", "description": "activity ID"},
            {"name": "user_id", "type": "int64", "description": "receiver user ID"},
            {"name": "op_type", "type": "string", "description": "action type enum"},
            {"name": "act_user_id", "type": "int64", "description": "actor user ID"},
            {"name": "act_user", "type": "*User", "description": "actor user object"},
            {"name": "repo_id", "type": "int64", "description": "repository ID"},
            {"name": "repo", "type": "*Repository", "description": "repository object"},
            {"name": "comment_id", "type": "int64", "description": "comment ID if applicable"},
            {"name": "comment", "type": "*Comment", "description": "comment object if applicable"},
            {"name": "ref_name", "type": "string", "description": "git ref name"},
            {"name": "is_private", "type": "bool", "description": "whether from private repo"},
            {"name": "content", "type": "string", "description": "activity content"},
            {"name": "created", "type": "time.Time", "description": "creation timestamp"}
          ]
        },
        "errors": [
          {"status_code": 404, "type": "notFound", "condition": "organization not found"}
        ]
      },
      "authentication": "optional (public access allowed, private feeds require membership)",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
