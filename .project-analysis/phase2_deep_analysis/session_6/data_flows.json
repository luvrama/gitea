    {
      "endpoint_id": "ep-035",
      "http_method": "GET",
      "path": "/api/v1/orgs/{org}/activities/feeds",
      "description": "Fetches paginated activity feeds for an organization, filtering by visibility based on auth status",
      "steps": [
        {
          "step": 1,
          "component": "orgAssignment(true)",
          "type": "utility",
          "file_path": "routers/api/v1/api.go",
          "input": "path param {org}",
          "output": "ctx.Org.Organization, ctx.ContextUser",
          "operations": ["resolve org by name from DB"],
          "calls_external": false,
          "database_ops": [{"operation": "SELECT", "table": "user", "description": "GetOrgByName: find org by lower_name and type=1"}],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 2,
          "component": "org.ListOrgActivityFeeds",
          "type": "controller",
          "file_path": "routers/api/v1/org/org.go",
          "input": "ctx with org resolved",
          "output": "JSON response",
          "operations": ["determine includePrivate based on admin/membership", "build GetFeedsOptions", "call feed_service.GetFeeds"],
          "calls_external": false,
          "database_ops": [{"operation": "SELECT", "table": "team_user", "description": "IsOrgMember check if non-admin signed-in user is org member"}],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 3,
          "component": "feed_service.GetFeeds",
          "type": "service",
          "file_path": "services/feed/feed.go",
          "input": "GetFeedsOptions",
          "output": "ActionList, count, error",
          "operations": ["delegates to activities_model.GetFeeds"],
          "calls_external": false,
          "database_ops": [],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 4,
          "component": "activities_model.GetFeeds",
          "type": "repository",
          "file_path": "models/activities/action_list.go",
          "input": "GetFeedsOptions",
          "output": "ActionList, count, error",
          "operations": ["build query condition based on actor/visibility", "paginated query on action table", "LoadAttributes (batch load users, repos, issues, comments)"],
          "calls_external": false,
          "database_ops": [
            {"operation": "SELECT", "table": "action", "description": "paginated query with conditions"},
            {"operation": "SELECT", "table": "user", "description": "LoadActUsers batch"},
            {"operation": "SELECT", "table": "repository", "description": "LoadRepositories batch"},
            {"operation": "SELECT", "table": "user", "description": "loadRepoOwner batch"},
            {"operation": "SELECT", "table": "issue", "description": "LoadIssues batch"},
            {"operation": "SELECT", "table": "comment", "description": "LoadComments batch"}
          ],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 5,
          "component": "convert.ToActivities",
          "type": "utility",
          "file_path": "services/convert/activity.go",
          "input": "ActionList, doer",
          "output": "[]*api.Activity",
          "operations": ["for each action: GetDoerRepoPermission (N+1 pattern)", "convert to API struct with ToUser, ToRepo, ToAPIComment"],
          "calls_external": false,
          "database_ops": [{"operation": "SELECT", "table": "access/collaboration/team", "description": "GetDoerRepoPermission per action (N+1)"}],
          "cache_ops": [],
          "async": false
        }
      ],
      "data_transformations": [
        {
          "from": "activities_model.Action",
          "to": "api.Activity",
          "component": "convert.ToActivity",
          "mappings": [
            {"source_field": "ID", "target_field": "ID", "transformation": "direct_copy"},
            {"source_field": "OpType", "target_field": "OpType", "transformation": "computed"},
            {"source_field": "ActUser", "target_field": "ActUser", "transformation": "enriched"},
            {"source_field": "Repo", "target_field": "Repo", "transformation": "enriched"},
            {"source_field": "CreatedUnix", "target_field": "Created", "transformation": "computed"}
          ]
        }
      ],
      "error_paths": [
        {"condition": "org not found", "handler": "orgAssignment middleware", "response_code": 404, "response": "notFound"},
        {"condition": "IsOrgMember fails", "handler": "ListOrgActivityFeeds", "response_code": 500, "response": "internal error"},
        {"condition": "GetFeeds fails", "handler": "ListOrgActivityFeeds", "response_code": 500, "response": "internal error"}
      ]
    },
    {
      "endpoint_id": "ep-036",
      "http_method": "DELETE",
      "path": "/api/v1/orgs/{org}/repos",
      "description": "Deletes all repositories in an organization asynchronously in background",
      "steps": [
        {
          "step": 1,
          "component": "orgAssignment(true) + reqOrgOwnership()",
          "type": "utility",
          "file_path": "routers/api/v1/api.go",
          "input": "path param {org}",
          "output": "ctx.Org.Organization verified as owned by doer",
          "operations": ["resolve org", "verify ownership"],
          "calls_external": false,
          "database_ops": [
            {"operation": "SELECT", "table": "user", "description": "GetOrgByName"},
            {"operation": "SELECT", "table": "team_user+team", "description": "reqOrgOwnership check"}
          ],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 2,
          "component": "org.DeleteOrgRepos",
          "type": "controller",
          "file_path": "routers/api/v1/org/org.go",
          "input": "ctx with org",
          "output": "202 Accepted or 204 No Content",
          "operations": ["get all repo IDs for org", "if empty return 204", "spawn background goroutine", "return 202"],
          "calls_external": false,
          "database_ops": [{"operation": "SELECT", "table": "repository", "description": "GetOrgRepositoryIDs: SELECT id FROM repository WHERE owner_id=?"}],
          "cache_ops": [],
          "async": true
        },
        {
          "step": 3,
          "component": "org.deleteOrgReposBackground",
          "type": "service",
          "file_path": "routers/api/v1/org/org.go",
          "input": "org, repoIDs, doer",
          "output": "none (background)",
          "operations": ["for each repoID: GetRepositoryByID then DeleteRepository", "log errors as system notices"],
          "calls_external": false,
          "database_ops": [
            {"operation": "SELECT", "table": "repository", "description": "GetRepositoryByID per repo"},
            {"operation": "DELETE", "table": "multiple", "description": "DeleteRepository: cascading delete of repo and all related data"}
          ],
          "cache_ops": [],
          "async": true
        }
      ],
      "data_transformations": [],
      "error_paths": [
        {"condition": "org not found", "handler": "orgAssignment middleware", "response_code": 404, "response": "notFound"},
        {"condition": "not org owner", "handler": "reqOrgOwnership middleware", "response_code": 403, "response": "forbidden"},
        {"condition": "GetOrgRepositoryIDs fails", "handler": "DeleteOrgRepos", "response_code": 500, "response": "internal error"},
        {"condition": "background deletion fails", "handler": "deleteOrgReposBackground", "response_code": 0, "response": "logged as system notice, no HTTP response"}
      ]
    },
