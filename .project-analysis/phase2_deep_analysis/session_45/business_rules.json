      "affected_endpoints": ["ep-307", "ep-309"],
      "code_snippet": "if totalNumOfBranches == 0 { _, err = repo_module.SyncRepoBranches(ctx, ctx.Repo.Repository.ID, 0) }"
    },
    {
      "rule_id": "br-008",
      "category": "validation",
