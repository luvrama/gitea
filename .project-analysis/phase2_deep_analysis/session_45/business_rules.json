      "category": "authorization",
      "description": "Only admins can rename default or protected branches",
      "location": {"class": "repo_service", "method": "RenameBranch", "file_path": "services/repository/branch.go", "line_number": 237},
      "condition": "isDefault && !perm.IsAdmin()",
      "action": "Return ErrUserDoesNotHaveAccessToRepo",
      "affected_endpoints": ["ep-311"],
      "code_snippet": "if isDefault && !perm.IsAdmin() { return \"\", repo_model.ErrUserDoesNotHaveAccessToRepo{...} }"
    },
    {
      "rule_id": "br-011",
      "category": "authorization",
      "description": "Cannot rename to a branch name that is protected and user cannot push to",
      "location": {"class": "repo_service", "method": "RenameBranch", "file_path": "services/repository/branch.go", "line_number": 253},
      "condition": "rule != nil && !rule.CanUserPush(ctx, doer)",
      "action": "Return ErrBranchIsProtected",
      "affected_endpoints": ["ep-311"],
      "code_snippet": "if rule != nil && !rule.CanUserPush(ctx, doer) { return \"\", git_model.ErrBranchIsProtected }"
    },
    {
      "rule_id": "br-012",
      "category": "business_logic",
      "description": "Renaming default branch also updates git HEAD, deletes scheduled actions, and cancels cron jobs",
      "location": {"class": "repo_service", "method": "RenameBranch", "file_path": "services/repository/branch.go", "line_number": 258},
      "condition": "isDefault (branch being renamed is the default branch)",
      "action": "Delete schedule tasks, cancel previous jobs, set new default branch in git",
