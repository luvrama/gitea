      "category": "business_logic",
      "description": "If no branches in DB for non-empty repo, sync from git immediately",
      "location": {"class": "repo", "method": "DeleteBranch", "file_path": "routers/api/v1/repo/branch.go", "line_number": 118},
      "condition": "totalNumOfBranches == 0 for non-empty repo",
