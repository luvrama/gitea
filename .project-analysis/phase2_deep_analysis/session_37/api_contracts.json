      "endpoint_id": "ep-246",
      "http_method": "GET",
      "path": "/api/v1/repos/{owner}/{repo}/git/trees/{sha}",
      "controller_class": "repo",
      "controller_method": "GetTree",
      "description": "Gets the tree of a repository by SHA hash with pagination support",
      "request": {
        "path_params": [
          {"name": "owner", "type": "string", "required": true, "validation": []},
          {"name": "repo", "type": "string", "required": true, "validation": []},
          {"name": "sha", "type": "string", "required": true, "validation": ["non-empty"]}
        ],
        "query_params": [
          {"name": "recursive", "type": "boolean", "required": false, "default": false, "validation": []},
          {"name": "page", "type": "integer", "required": false, "default": 1, "validation": []},
          {"name": "per_page", "type": "integer", "required": false, "default": 1000, "validation": ["max 1000 (DefaultGitTreesPerPage)"]}
        ],
        "headers": [],
        "body": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "type": "GitTreeResponse",
          "fields": [
            {"name": "sha", "type": "string", "description": "Tree object SHA"},
            {"name": "url", "type": "string", "description": "API URL for this tree"},
            {"name": "tree", "type": "[]GitEntry", "description": "Array of tree entries"},
            {"name": "truncated", "type": "boolean", "description": "Whether more items exist after this page"},
            {"name": "page", "type": "integer", "description": "Current page number"},
            {"name": "total_count", "type": "integer", "description": "Total number of entries"}
          ]
        },
        "errors": [
          {"status_code": 400, "type": "error", "condition": "SHA not provided or SHA not found in repository"},
          {"status_code": 404, "type": "notFound", "condition": "Repository not found"}
        ]
      },
      "authentication": "bearer",
      "rate_limiting": null,
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
