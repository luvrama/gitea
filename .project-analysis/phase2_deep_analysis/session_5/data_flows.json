      "endpoint_id": "ep-034",
      "http_method": "DELETE",
      "path": "/api/v1/orgs/{org}",
      "description": "Deletes an organization completely, including all associated data (teams, members, secrets, runners) but fails if org still has repos or packages",
      "steps": [
        {
          "step": 1,
          "component": "orgAssignment(true) + reqToken + reqOrgOwnership",
