          "input": "APIContext",
          "output": "204 No Content",
          "operations": ["Calls org.DeleteOrganization(ctx, org, false)"],
          "calls_external": false,
          "database_ops": [],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 3,
          "component": "org.DeleteOrganization",
          "type": "service",
          "file_path": "services/org/org.go",
          "input": "(*Organization, purge=false)",
          "output": "error",
          "operations": ["In transaction: counts repos (fails if >0), checks packages (fails if owns any), deletes all org beans (teams, org_users, team_users, team_units, team_invites, secrets, blockings, action_runners, action_runner_tokens, user record)", "After tx: removes filesystem directory, deletes avatar from storage"],
          "calls_external": false,
          "database_ops": [
            {"operation": "SELECT COUNT", "table": "repository", "description": "Check if org owns any repos"},
            {"operation": "SELECT", "table": "package", "description": "Check if org owns any packages"},
            {"operation": "DELETE", "table": "team", "description": "Delete all teams"},
            {"operation": "DELETE", "table": "org_user", "description": "Delete all org memberships"},
            {"operation": "DELETE", "table": "team_user", "description": "Delete all team memberships"},
            {"operation": "DELETE", "table": "team_unit", "description": "Delete all team units"},
            {"operation": "DELETE", "table": "team_invite", "description": "Delete all team invites"},
            {"operation": "DELETE", "table": "secret", "description": "Delete all org secrets"},
            {"operation": "DELETE", "table": "user_blocking", "description": "Delete all org blocks"},
            {"operation": "DELETE", "table": "action_runner", "description": "Delete all org runners"},
            {"operation": "DELETE", "table": "action_runner_token", "description": "Delete all runner tokens"},
            {"operation": "DELETE", "table": "user", "description": "Delete the org user record"}
          ],
          "cache_ops": [],
          "async": false
        }
      ],
      "data_transformations": [],
      "error_paths": [
        {"condition": "Org still has repositories", "handler": "ctx.APIErrorInternal", "response_code": 500, "response": "ErrUserOwnRepos"},
        {"condition": "Org still has packages", "handler": "ctx.APIErrorInternal", "response_code": 500, "response": "ErrUserOwnPackages"},
        {"condition": "Database error", "handler": "ctx.APIErrorInternal", "response_code": 500, "response": "internal error"}
