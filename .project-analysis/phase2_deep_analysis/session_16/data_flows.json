      "steps": [
        {
          "step": 1,
          "component": "admin.ListUnadoptedRepositories",
          "type": "controller",
          "file_path": "routers/api/v1/admin/adopt.go",
          "input": "APIContext",
          "output": "JSON string array",
          "operations": [
            "Get list options from query params",
            "Get query/pattern from form",
            "Call repo_service.ListUnadoptedRepositories"
          ],
          "calls_external": false,
          "database_ops": [],
          "cache_ops": [],
          "async": false
        },
        {
          "step": 2,
          "component": "repo_service.ListUnadoptedRepositories",
          "type": "service",
          "file_path": "services/repository/adopt.go",
          "input": "context, query string, ListOptions",
          "output": "([]string, int64, error)",
          "operations": [
            "Parse query into user/repo glob patterns",
            "Walk RepoRootPath filesystem directory",
            "For each user directory matching glob, collect .git repo names",
            "Batch check repos against DB via GetUserRepositories",
