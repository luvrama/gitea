            {"operation": "SELECT", "table": "user", "description": "GetUserByName for each user directory"},
            {"operation": "SELECT", "table": "repository", "description": "GetUserRepositories to check which repos are already adopted"}
          ],
          "cache_ops": [],
          "async": false
        }
      ],
      "data_transformations": [],
      "error_paths": [
        {"condition": "Filesystem walk error", "handler": "admin.ListUnadoptedRepositories", "response_code": 500, "response": "internal error"}
      ]
    },
