          "input": "ActionRun",
          "output": "*api.ActionWorkflowRun",
          "operations": ["Convert internal run model to API response struct"],
          "calls_external": false,
          "database_ops": [],
          "cache_ops": [],
          "async": false
        }
      ],
      "data_transformations": [
        {
          "from": "actions_model.ActionRun",
          "to": "api.ActionWorkflowRun",
