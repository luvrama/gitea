            {"operation": "INSERT", "table": "branch", "description": "Sync branches from git"},
            {"operation": "INSERT", "table": "release", "description": "Sync releases/tags from git"},
            {"operation": "UPDATE", "table": "repository", "description": "Set status to Ready"}
          ],
          "cache_ops": [],
          "async": false
        }
      ],
      "data_transformations": [],
      "error_paths": [
        {"condition": "User not found", "handler": "admin.AdoptRepository", "response_code": 404, "response": "notFound"},
        {"condition": "Repo already in DB or not on disk", "handler": "admin.AdoptRepository", "response_code": 404, "response": "notFound"},
        {"condition": "Adoption failure", "handler": "admin.AdoptRepository", "response_code": 500, "response": "internal error"}
      ]
    },
