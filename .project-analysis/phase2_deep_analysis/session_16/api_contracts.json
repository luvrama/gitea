    {
      "endpoint_id": "ep-106",
      "http_method": "GET",
      "path": "/api/v1/admin/actions/runs",
      "controller_class": "admin",
      "controller_method": "ListWorkflowRuns",
      "description": "Lists all workflow runs across all repositories (admin-level)",
      "request": {
        "path_params": [],
        "query_params": [
          {"name": "event", "type": "string", "required": false, "default": null, "validation": []},
          {"name": "branch", "type": "string", "required": false, "default": null, "validation": []},
          {"name": "status", "type": "string", "required": false, "default": null, "validation": ["pending|waiting|requested|action_required|queued|in_progress|completed|failure|success|skipped|neutral|cancelled|timed_out"]},
          {"name": "actor", "type": "string", "required": false, "default": null, "validation": ["must be existing username"]},
          {"name": "head_sha", "type": "string", "required": false, "default": null, "validation": []},
          {"name": "page", "type": "integer", "required": false, "default": 1, "validation": ["min:1"]},
          {"name": "limit", "type": "integer", "required": false, "default": null, "validation": ["corrected by ToCorrectPageSize"]}
        ],
        "headers": [{"name": "Authorization", "required": true, "description": "Admin token with admin scope"}],
        "body": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "type": "ActionWorkflowRunsResponse",
          "fields": [
            {"name": "workflow_runs", "type": "[]*ActionWorkflowRun", "description": "List of workflow runs"},
            {"name": "total_count", "type": "int64", "description": "Total number of matching runs"}
          ]
        },
        "errors": [
          {"status_code": 400, "type": "error", "condition": "Invalid status value provided"},
          {"status_code": 404, "type": "notFound", "condition": "Not found"},
          {"status_code": 500, "type": "internal", "condition": "DB error or user lookup failure"}
        ]
      },
      "authentication": "bearer (token with AccessTokenScopeCategoryAdmin)",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
