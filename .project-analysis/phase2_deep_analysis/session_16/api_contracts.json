    {
      "endpoint_id": "ep-112",
      "http_method": "POST",
      "path": "/api/v1/admin/users/{username}/repos",
      "controller_class": "admin",
      "controller_method": "CreateRepo",
      "description": "Creates a repository on behalf of a user (admin only)",
      "request": {
        "path_params": [
          {"name": "username", "type": "string", "required": true, "validation": ["must be existing user"]}
        ],
        "query_params": [],
        "headers": [{"name": "Authorization", "required": true, "description": "Admin token with admin scope"}],
        "body": {
          "type": "CreateRepoOption",
          "content_type": "application/json",
          "fields": [
            {"name": "name", "type": "string", "required": true, "validation": ["AlphaDashDot", "MaxSize(100)"], "description": "Repository name"},
            {"name": "description", "type": "string", "required": false, "validation": ["MaxSize(2048)"], "description": "Repository description"},
            {"name": "private", "type": "bool", "required": false, "validation": [], "description": "Whether repo is private"},
            {"name": "issue_labels", "type": "string", "required": false, "validation": ["MaxSize(255)"], "description": "Label-Set to use"},
            {"name": "auto_init", "type": "bool", "required": false, "validation": [], "description": "Auto-initialize with README"},
            {"name": "template", "type": "bool", "required": false, "validation": [], "description": "Whether repo is a template"},
            {"name": "gitignores", "type": "string", "required": false, "validation": [], "description": "Gitignores to use"},
            {"name": "license", "type": "string", "required": false, "validation": ["MaxSize(100)"], "description": "License to use"},
            {"name": "readme", "type": "string", "required": false, "validation": ["MaxSize(255)"], "description": "Readme template"},
            {"name": "default_branch", "type": "string", "required": false, "validation": ["GitRefName", "MaxSize(100)"], "description": "Default branch name"},
            {"name": "trust_model", "type": "string", "required": false, "validation": ["enum: default,collaborator,committer,collaboratorcommitter"], "description": "Trust model"},
            {"name": "object_format_name", "type": "string", "required": false, "validation": ["MaxSize(6)"], "description": "Object format (sha1 default)"}
          ]
        }
      },
      "response": {
        "success": {
          "status_code": 201,
          "type": "Repository",
          "fields": [
            {"name": "id", "type": "int64", "description": "Repository ID"},
            {"name": "name", "type": "string", "description": "Repository name"},
            {"name": "full_name", "type": "string", "description": "Full name (owner/repo)"},
            {"name": "owner", "type": "User", "description": "Repository owner"}
          ]
        },
        "errors": [
          {"status_code": 400, "type": "error", "condition": "Invalid readme template"},
          {"status_code": 403, "type": "forbidden", "condition": "Permission denied"},
          {"status_code": 404, "type": "notFound", "condition": "User not found"},
          {"status_code": 409, "type": "error", "condition": "Repository with same name already exists"},
          {"status_code": 422, "type": "validationError", "condition": "Reserved name or invalid pattern"}
        ]
      },
