        ],
        "query_params": [],
        "headers": [],
        "body": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "type": "api.PullRequest",
          "fields": [
            {"name": "id", "type": "int64", "description": "PR ID"},
            {"name": "number", "type": "int64", "description": "PR number"},
