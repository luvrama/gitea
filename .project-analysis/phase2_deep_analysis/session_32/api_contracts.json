          {"name": "diffType", "type": "string", "required": true, "validation": ["enum: diff, patch"]}
        ],
        "query_params": [],
        "headers": [],
        "body": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "type": "text/plain",
          "fields": []
        },
        "errors": [
          {"status_code": 404, "type": "notFound", "condition": "commit does not exist"}
        ]
      },
      "authentication": "token",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
    {
      "endpoint_id": "ep-217",
      "http_method": "GET",
      "path": "/api/v1/repos/{owner}/{repo}/commits/{sha}/pull",
