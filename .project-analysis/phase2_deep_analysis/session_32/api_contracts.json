            {"name": "merged", "type": "bool", "description": "whether merged"},
            {"name": "base", "type": "PRBranchInfo", "description": "base branch info"},
            {"name": "head", "type": "PRBranchInfo", "description": "head branch info"}
          ]
        },
        "errors": [
          {"status_code": 404, "type": "notFound", "condition": "no merged PR found for this commit"}
        ]
      },
      "authentication": "token",
