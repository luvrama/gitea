{
  "total_endpoints": 6,
  "endpoints": [
    {
      "endpoint_id": "ep-214",
      "http_method": "GET",
      "path": "/api/v1/repos/{owner}/{repo}/git/commits/{sha}",
      "controller_class": "repo",
      "controller_method": "GetSingleCommit",
      "description": "Get a single commit from a repository by SHA or ref",
      "request": {
        "path_params": [
          {"name": "owner", "type": "string", "required": true, "validation": []},
          {"name": "repo", "type": "string", "required": true, "validation": []},
          {"name": "sha", "type": "string", "required": true, "validation": ["must pass IsValidRefPattern"]}
        ],
        "query_params": [
          {"name": "stat", "type": "boolean", "required": false, "default": true, "validation": []},
          {"name": "verification", "type": "boolean", "required": false, "default": true, "validation": []},
          {"name": "files", "type": "boolean", "required": false, "default": true, "validation": []}
        ],
        "headers": [],
        "body": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "type": "api.Commit",
          "fields": [
            {"name": "sha", "type": "string", "description": "commit SHA"},
            {"name": "url", "type": "string", "description": "API URL"},
            {"name": "html_url", "type": "string", "description": "HTML URL"},
            {"name": "commit", "type": "RepoCommit", "description": "commit details (author, committer, message, tree, verification)"},
            {"name": "author", "type": "User", "description": "API user for author"},
            {"name": "committer", "type": "User", "description": "API user for committer"},
            {"name": "parents", "type": "[]CommitMeta", "description": "parent commits"},
            {"name": "files", "type": "[]CommitAffectedFiles", "description": "affected files (if files=true)"},
            {"name": "stats", "type": "CommitStats", "description": "diff stats (if stat=true)"}
          ]
        },
        "errors": [
          {"status_code": 422, "type": "validationError", "condition": "sha is not a valid ref pattern"},
          {"status_code": 404, "type": "notFound", "condition": "commit does not exist"}
        ]
      },
      "authentication": "token",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
    {
      "endpoint_id": "ep-215",
      "http_method": "GET",
      "path": "/api/v1/repos/{owner}/{repo}/commits",
      "controller_class": "repo",
      "controller_method": "GetAllCommits",
      "description": "Get a list of all commits from a repository with pagination",
      "request": {
        "path_params": [
          {"name": "owner", "type": "string", "required": true, "validation": []},
          {"name": "repo", "type": "string", "required": true, "validation": []}
        ],
        "query_params": [
          {"name": "sha", "type": "string", "required": false, "default": null, "validation": []},
          {"name": "path", "type": "string", "required": false, "default": null, "validation": []},
          {"name": "since", "type": "string", "required": false, "default": null, "validation": ["RFC3339 format"]},
          {"name": "until", "type": "string", "required": false, "default": null, "validation": ["RFC3339 format"]},
          {"name": "stat", "type": "boolean", "required": false, "default": true, "validation": []},
          {"name": "verification", "type": "boolean", "required": false, "default": true, "validation": []},
          {"name": "files", "type": "boolean", "required": false, "default": true, "validation": []},
          {"name": "page", "type": "integer", "required": false, "default": 1, "validation": []},
          {"name": "limit", "type": "integer", "required": false, "default": null, "validation": ["max: setting.Git.CommitsRangeSize (50)"]},
          {"name": "not", "type": "string", "required": false, "default": null, "validation": []}
        ],
        "headers": [],
        "body": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "type": "[]api.Commit",
          "fields": [
            {"name": "X-Page", "type": "header", "description": "current page"},
            {"name": "X-PerPage", "type": "header", "description": "page size"},
            {"name": "X-Total", "type": "header", "description": "total commit count"},
            {"name": "X-PageCount", "type": "header", "description": "total pages"},
            {"name": "X-HasMore", "type": "header", "description": "whether more pages exist"}
          ]
        },
        "errors": [
          {"status_code": 404, "type": "notFound", "condition": "repository or commit not found"},
          {"status_code": 409, "type": "EmptyRepository", "condition": "repository is empty"},
          {"status_code": 422, "type": "validationError", "condition": "invalid since/until format"}
        ]
      },
      "authentication": "token",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
    {
      "endpoint_id": "ep-216",
      "http_method": "GET",
      "path": "/api/v1/repos/{owner}/{repo}/git/commits/{sha}.{diffType}",
      "controller_class": "repo",
