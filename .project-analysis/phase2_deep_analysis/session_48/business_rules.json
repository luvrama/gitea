      "action": "Delete webhook and all hook_tasks in transaction",
      "affected_endpoints": ["ep-326"],
      "code_snippet": "return db.WithTx(ctx, func(ctx context.Context) error {\n\tif count, err := db.DeleteByID[Webhook](ctx, id); err != nil {"
    },
