      "affected_endpoints": ["ep-325", "ep-326"],
      "code_snippet": "has, err := db.GetEngine(ctx).Where(\"id=? AND repo_id=?\", id, repoID).Get(webhook)"
    },
    {
      "rule_id": "br-008",
      "category": "validation",
      "description": "Repository must be owned by an organization to list teams",
      "location": {"class": "repo", "method": "ListTeams", "file_path": "routers/api/v1/repo/teams.go", "line_number": 38},
      "condition": "!ctx.Repo.Owner.IsOrganization()",
      "action": "Return 405 Method Not Allowed",
      "affected_endpoints": ["ep-329"],
      "code_snippet": "if !ctx.Repo.Owner.IsOrganization() {\n\tctx.APIError(http.StatusMethodNotAllowed, \"repo is not owned by an organization\")"
    },
    {
      "rule_id": "br-009",
