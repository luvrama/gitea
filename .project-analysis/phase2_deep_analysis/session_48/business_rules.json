  "rules": [
    {
      "rule_id": "br-001",
      "category": "validation",
      "description": "Hook type must be a valid registered webhook type",
      "location": {"class": "utils", "method": "checkCreateHookOption", "file_path": "routers/api/v1/utils/hook.go", "line_number": 83},
      "condition": "!webhook_service.IsValidHookTaskType(form.Type)",
      "action": "Return 422 with invalid hook type message",
      "affected_endpoints": ["ep-324"],
      "code_snippet": "if !webhook_service.IsValidHookTaskType(form.Type) {\n\tctx.APIError(http.StatusUnprocessableEntity, \"Invalid hook type: \"+form.Type)"
    },
    {
      "rule_id": "br-002",
      "category": "validation",
      "description": "Config must contain 'url' and 'content_type' keys",
      "location": {"class": "utils", "method": "checkCreateHookOption", "file_path": "routers/api/v1/utils/hook.go", "line_number": 87},
      "condition": "Missing 'url' or 'content_type' in form.Config",
      "action": "Return 422 with missing config option message",
      "affected_endpoints": ["ep-324"],
      "code_snippet": "for _, name := range []string{\"url\", \"content_type\"} {\n\tif _, ok := form.Config[name]; !ok {"
    },
    {
      "rule_id": "br-003",
      "category": "validation",
      "description": "URL must be a valid URL format",
      "location": {"class": "utils", "method": "checkCreateHookOption", "file_path": "routers/api/v1/utils/hook.go", "line_number": 96},
      "condition": "!validation.IsValidURL(form.Config[\"url\"])",
      "action": "Return 422 with invalid url message",
      "affected_endpoints": ["ep-324", "ep-325"],
      "code_snippet": "if !validation.IsValidURL(form.Config[\"url\"]) {\n\tctx.APIError(http.StatusUnprocessableEntity, \"Invalid url\")"
    },
    {
      "rule_id": "br-004",
      "category": "validation",
      "description": "Slack webhooks require a valid channel name in config",
      "location": {"class": "utils", "method": "addHook", "file_path": "routers/api/v1/utils/hook.go", "line_number": 175},
      "condition": "w.Type == webhook_module.SLACK && channel missing or invalid",
      "action": "Return 422 or 400 with channel error",
      "affected_endpoints": ["ep-324"],
      "code_snippet": "if !webhook_service.IsValidSlackChannel(channel) {\n\tctx.APIError(http.StatusBadRequest, \"Invalid slack channel name\")"
    },
    {
      "rule_id": "br-005",
      "category": "business_logic",
      "description": "Default events to ['push'] when no events specified",
      "location": {"class": "utils", "method": "updateHookEvents", "file_path": "routers/api/v1/utils/hook.go", "line_number": 139},
      "condition": "len(events) == 0",
      "action": "Set events to [\"push\"]",
      "affected_endpoints": ["ep-324", "ep-325"],
      "code_snippet": "if len(events) == 0 {\n\tevents = []string{\"push\"}\n}"
    },
    {
