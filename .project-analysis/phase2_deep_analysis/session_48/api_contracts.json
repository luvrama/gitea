            {"name": "branch_filter", "type": "string", "required": false, "validation": ["GlobPattern"], "description": "Branch filter glob pattern"},
            {"name": "authorization_header", "type": "string", "required": false, "validation": [], "description": "Authorization header for webhook requests"},
            {"name": "active", "type": "bool", "required": false, "validation": [], "description": "Whether webhook is active, default false"},
            {"name": "name", "type": "string", "required": false, "validation": ["MaxSize(255)"], "description": "Human-readable name"}
          ]
        }
      },
      "response": {
        "success": {
          "status_code": 201,
          "type": "Hook",
          "fields": [
            {"name": "id", "type": "int64", "description": "Webhook ID"},
            {"name": "name", "type": "string", "description": "Webhook name"},
            {"name": "type", "type": "string", "description": "Webhook type"},
            {"name": "branch_filter", "type": "string", "description": "Branch filter pattern"},
            {"name": "config", "type": "map[string]string", "description": "Config with url, content_type"},
            {"name": "events", "type": "[]string", "description": "Enabled events"},
            {"name": "authorization_header", "type": "string", "description": "Auth header"},
            {"name": "active", "type": "bool", "description": "Whether active"},
            {"name": "updated_at", "type": "time.Time", "description": "Last update time"},
            {"name": "created_at", "type": "time.Time", "description": "Creation time"}
          ]
        },
        "errors": [
          {"status_code": 404, "type": "notFound", "condition": "Repository not found"},
          {"status_code": 422, "type": "error", "condition": "Invalid hook type, missing config options, invalid URL or content_type"}
        ]
      },
      "authentication": "bearer",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
