        "body": {
          "type": "CreateHookOption",
          "content_type": "application/json",
          "fields": [
            {"name": "type", "type": "string", "required": true, "validation": ["must be valid hook type: dingtalk,discord,gitea,gogs,msteams,slack,telegram,feishu,wechatwork,packagist"], "description": "Webhook type"},
