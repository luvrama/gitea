    {
      "endpoint_id": "ep-164",
      "http_method": "GET",
      "path": "/api/v1/users/{username}/tokens",
      "controller_class": "user",
      "controller_method": "ListAccessTokens",
      "description": "List the authenticated user's access tokens (requires basic auth or reverse proxy auth)",
      "request": {
        "path_params": [{"name": "username", "type": "string", "required": true, "validation": ["resolved by UserAssignmentAPI middleware"]}],
        "query_params": [
          {"name": "page", "type": "integer", "required": false, "default": 1, "validation": [">=1"]},
          {"name": "limit", "type": "integer", "required": false, "default": null, "validation": ["<=50"]}
        ],
        "headers": [{"name": "Authorization", "required": true, "description": "Basic auth or reverse proxy auth required"}],
        "body": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "type": "AccessTokenList",
          "fields": [
            {"name": "id", "type": "int64", "description": "Token ID"},
            {"name": "name", "type": "string", "description": "Token name"},
            {"name": "sha1", "type": "string", "description": "Always empty in list (token not stored)"},
            {"name": "token_last_eight", "type": "string", "description": "Last 8 chars of token"},
            {"name": "scopes", "type": "[]string", "description": "Token scopes"},
            {"name": "created_at", "type": "time", "description": "Creation timestamp"},
            {"name": "last_used_at", "type": "time", "description": "Last usage timestamp"}
          ]
        },
        "errors": [
          {"status_code": 403, "type": "forbidden", "condition": "Not self or admin"}
        ]
      },
      "authentication": "basic_or_reverse_proxy",
      "rate_limiting": "none",
      "caching": {"cache_control": null, "ttl_seconds": null}
    },
    {
