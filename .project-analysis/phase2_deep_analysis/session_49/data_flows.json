            {"operation": "UPDATE", "table": "repository", "description": "increment fork num on base"},
            {"operation": "INSERT", "table": "lfs_meta_object", "description": "copy LFS objects"},
            {"operation": "INSERT", "table": "branch", "description": "sync branches"},
            {"operation": "INSERT", "table": "release", "description": "sync releases/tags"},
            {"operation": "UPDATE", "table": "repository", "description": "set status ready"}
          ],
          "cache_ops": [],
          "async": false
        }
